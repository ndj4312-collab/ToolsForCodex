{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://production-orchestration-kit.local/contracts/orchestrator-config.schema.json",
  "title": "Orchestrator configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "targetRoot", "auditIgnore", "allowedWriteRoots", "enabledRuntimes", "securityMode", "outputDirectory"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "targetRoot": { "$ref": "#/$defs/relativePath" },
    "auditIgnore": { "type": "array", "items": { "$ref": "#/$defs/relativePath" }, "uniqueItems": true },
    "allowedWriteRoots": { "type": "array", "items": { "$ref": "#/$defs/relativePath" }, "uniqueItems": true },
    "enabledRuntimes": { "type": "array", "items": { "enum": ["claude", "codex", "gemini"] }, "minItems": 1, "uniqueItems": true },
    "securityMode": { "enum": ["read-only", "approved-transactions"] },
    "outputDirectory": { "$ref": "#/$defs/relativePath" }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:)(?!/)(?!\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*(?:^|/)~(?:/|$))(?!.*\\$[A-Za-z_])[A-Za-z0-9._/-]+$"
    }
  }
}
