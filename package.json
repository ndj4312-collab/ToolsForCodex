{
  "name": "production-orchestration-kit",
  "version": "0.2.0",
  "private": true,
  "description": "Deterministic, read-only-first repository orchestration tooling.",
  "type": "commonjs",
  "bin": {
    "orchestrator": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint . --max-warnings=0",
    "test": "jest",
    "preflight": "tsx src/cli.ts preflight",
    "audit": "tsx src/cli.ts audit",
    "catalog": "tsx src/cli.ts catalog",
    "plan": "tsx src/cli.ts plan",
    "propose": "tsx src/cli.ts propose",
    "bootstrap": "tsx src/cli.ts bootstrap",
    "verify-adapters": "tsx src/cli.ts verify-adapters",
    "doctor": "tsx src/cli.ts doctor",
    "stage": "tsx src/cli.ts stage",
    "verify": "tsx src/cli.ts verify",
    "approve": "tsx src/cli.ts approve",
    "apply": "tsx src/cli.ts apply",
    "rollback": "tsx src/cli.ts rollback",
    "validate-release": "node scripts/validate-release.mjs",
    "normalize-approved": "node scripts/normalize-approved-bundles.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.15.30",
    "eslint": "^9.34.0",
    "jest": "^30.0.5",
    "ts-jest": "^29.4.1",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.41.0"
  }
}
