{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://production-orchestration-kit.local/contracts/asset.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "path", "sha256", "observedAt", "source", "evidence"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$" },
    "path": { "$ref": "#/$defs/path" },
    "sha256": { "$ref": "#/$defs/sha256" },
    "observedAt": { "type": "string", "format": "date-time" },
    "source": { "$ref": "#/$defs/source" },
    "evidence": { "$ref": "#/$defs/evidence" }
  },
  "$defs": {
    "path": { "type": "string", "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "source": { "type": "object", "additionalProperties": false, "required": ["locator"], "properties": { "locator": { "type": "string", "minLength": 1 } } },
    "evidence": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["kind", "locator"], "properties": { "kind": { "type": "string", "minLength": 1 }, "locator": { "type": "string", "minLength": 1 } } } }
  }
}
