{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://production-orchestration-kit.local/contracts/runtime-adapter.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "generatedAt", "runtime", "source", "sourceHash", "status", "evidence"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "runtime": { "enum": ["claude", "codex", "gemini"] },
    "source": { "type": "object", "additionalProperties": false, "required": ["locator"], "properties": { "locator": { "type": "string" } } },
    "sourceHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "status": { "enum": ["generated", "verified", "blocked"] },
    "evidence": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["kind", "locator"], "properties": { "kind": { "type": "string" }, "locator": { "type": "string" } } } }
  }
}
