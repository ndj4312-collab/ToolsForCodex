{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://production-orchestration-kit.local/contracts/diagnostic-result.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "createdAt", "severity", "status", "source", "evidence"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$" },
    "createdAt": { "type": "string", "format": "date-time" },
    "severity": { "enum": ["info", "warning", "error", "critical"] },
    "status": { "enum": ["VERIFIED", "UNKNOWN", "BLOCKED", "INVALID"] },
    "source": { "type": "object", "additionalProperties": false, "required": ["locator"], "properties": { "locator": { "type": "string", "minLength": 1 } } },
    "evidence": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["kind", "locator"], "properties": { "kind": { "type": "string" }, "locator": { "type": "string" } } } }
  }
}
