{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://production-orchestration-kit.local/contracts/catalog.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "generatedAt", "targetPath", "assets", "evidence"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "targetPath": { "$ref": "#/$defs/path" },
    "assets": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["id", "path", "sha256"], "properties": { "id": { "type": "string" }, "path": { "$ref": "#/$defs/path" }, "sha256": { "$ref": "#/$defs/sha256" } } } },
    "evidence": { "$ref": "#/$defs/evidence" }
  },
  "$defs": {
    "path": { "type": "string", "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "evidence": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["kind", "locator"], "properties": { "kind": { "type": "string" }, "locator": { "type": "string" } } } }
  }
}
