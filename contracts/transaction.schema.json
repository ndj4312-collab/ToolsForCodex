{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://production-orchestration-kit.local/contracts/transaction.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "createdAt", "status", "source", "manifestHash", "evidence"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$" },
    "createdAt": { "type": "string", "format": "date-time" },
    "status": { "enum": ["staged", "approved", "applied", "rolled-back", "blocked"] },
    "source": { "type": "object", "additionalProperties": false, "required": ["locator"], "properties": { "locator": { "type": "string" } } },
    "manifestHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "evidence": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["kind", "locator"], "properties": { "kind": { "type": "string" }, "locator": { "type": "string" } } } }
  }
}
