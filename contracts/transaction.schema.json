{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://production-orchestration-kit.local/contracts/transaction.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "createdAt", "status", "source", "manifestHash", "operations", "evidence"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$" },
    "createdAt": { "type": "string", "format": "date-time" },
    "status": { "enum": ["PLANNED", "STAGED", "VERIFIED", "APPROVED", "APPLIED", "ROLLED_BACK", "FAILED", "staged", "approved", "applied", "rolled-back", "blocked"] },
    "source": { "type": "object", "additionalProperties": false, "required": ["locator"], "properties": { "locator": { "type": "string" } } },
    "manifestHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "operations": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["path", "operation", "originalHash", "stagedHash"], "properties": { "path": { "$ref": "#/$defs/path" }, "operation": { "enum": ["create", "replace", "delete"] }, "originalHash": { "type": "string", "pattern": "^(absent|[a-f0-9]{64})$" }, "stagedHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" } } } },
    "evidence": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["kind", "locator"], "properties": { "kind": { "type": "string" }, "locator": { "type": "string" } } } },
    "approval": { "type": "object", "additionalProperties": false, "required": ["transactionId", "planDigest", "approvedAt", "allowedOperations"], "properties": { "transactionId": { "type": "string" }, "planDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "approvedAt": { "type": "string", "format": "date-time" }, "allowedOperations": { "type": "array", "items": { "enum": ["create", "replace", "delete"] }, "uniqueItems": true } } }
  },
  "$defs": {
    "path": { "type": "string", "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$" }
  }
}
