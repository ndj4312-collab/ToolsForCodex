{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://toolsforcodex.local/contracts/idealize-route.schema.json",
  "title": "ToolsForCodex IDEALIZE Route",
  "type": "object",
  "required": ["version","entrypoint","stages","workaround_order","adaptation_order","fail_closed","regression_rule"],
  "properties": {
    "version":{"type":"string","minLength":1},
    "entrypoint":{"const":"/idealize <idea>"},
    "stages":{"type":"array","minItems":4,"maxItems":4,"prefixItems":[
      {"$ref":"#/$defs/about"},{"$ref":"#/$defs/investigate"},{"$ref":"#/$defs/monolithize"},{"$ref":"#/$defs/idealize"}
    ],"items":false},
    "workaround_order":{"type":"array","minItems":10,"uniqueItems":true,"items":{"type":"string","minLength":1}},
    "adaptation_order":{"const":["USE","WRAP","SPECIALIZE","COMPOSE","MODIFY","EXTRACT_PATTERN","BUILD"]},
    "fail_closed":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
    "regression_rule":{"type":"string","minLength":1}
  },
  "$defs": {
    "stage":{"type":"object","required":["id","skill","requires","success","retry","fallback","abort"],"properties":{"id":{"type":"string"},"skill":{"type":"string","minLength":1},"requires":{"type":"array","items":{"type":"string"}},"success":{"type":"string","minLength":1},"retry":{"type":"string","minLength":1},"fallback":{"type":"string","minLength":1},"abort":{"type":"string","minLength":1}},"additionalProperties":false},
    "about":{"allOf":[{"$ref":"#/$defs/stage"},{"type":"object","properties":{"id":{"const":"about"}}}]},
    "investigate":{"allOf":[{"$ref":"#/$defs/stage"},{"type":"object","properties":{"id":{"const":"investigate"}}}]},
    "monolithize":{"allOf":[{"$ref":"#/$defs/stage"},{"type":"object","properties":{"id":{"const":"monolithize"}}}]},
    "idealize":{"allOf":[{"$ref":"#/$defs/stage"},{"type":"object","properties":{"id":{"const":"idealize"}}}]}
  },
  "additionalProperties": false
}
