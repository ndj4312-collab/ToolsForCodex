{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://toolsforcodex.local/contracts/ideal-project-plan.schema.json",
  "title": "IDEALIZE executable project plan",
  "type": "object",
  "required": ["schemaVersion", "idea", "perfectedState", "canonicalSources", "requirements", "tasks", "edges", "gates", "residualRisks"],
  "properties": {
    "schemaVersion": {"type":"string","minLength":1},
    "idea": {"type":"string","minLength":1},
    "perfectedState": {"type":"string","minLength":1},
    "canonicalSources": {"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
    "requirements": {"type":"array","minItems":1,"items":{"type":"object","required":["id","statement","evidence"],"properties":{"id":{"type":"string","minLength":1},"statement":{"type":"string","minLength":1},"evidence":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}}},"additionalProperties":false}},
    "tasks": {"type":"array","minItems":1,"items":{"$ref":"#/$defs/task"}},
    "edges": {"type":"array","items":{"type":"object","required":["from","to","relation"],"properties":{"from":{"type":"string","minLength":1},"to":{"type":"string","minLength":1},"relation":{"enum":["REQUIRES","BLOCKS","PARALLEL_WITH","CONFLICTS_WITH","PRODUCES","CONSUMES","VERIFIES","FALLBACK_FOR"]}},"additionalProperties":false}},
    "gates": {"type":"array","minItems":1,"items":{"type":"object","required":["id","afterWave","evidence"],"properties":{"id":{"type":"string","minLength":1},"afterWave":{"type":"integer","minimum":1},"evidence":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}}},"additionalProperties":false}},
    "residualRisks": {"type":"array","items":{"type":"string"}}
  },
  "$defs": {
    "stringList": {"type":"array","items":{"type":"string"}},
    "task": {
      "type": "object",
      "required": ["id","requirementIds","action","rationale","owner","surface","runtime","capability","prerequisites","inputs","outputs","permissions","readSet","writeSet","executionClass","phase","wave","parallel","acceptance","evidence","failure","branch","workaround","fallback","rollback","escalation","downstreamUnlocks","canonicalDestination"],
      "properties": {
        "id":{"type":"string","minLength":1},"requirementIds":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},"action":{"type":"string","minLength":1},"rationale":{"type":"string","minLength":1},"owner":{"type":"string","minLength":1},"surface":{"type":"string","minLength":1},"runtime":{"type":"string","minLength":1},"capability":{"type":"string","minLength":1},"prerequisites":{"$ref":"#/$defs/stringList"},"inputs":{"$ref":"#/$defs/stringList"},"outputs":{"$ref":"#/$defs/stringList"},"permissions":{"$ref":"#/$defs/stringList"},"readSet":{"$ref":"#/$defs/stringList"},"writeSet":{"$ref":"#/$defs/stringList"},"executionClass":{"enum":["READ_ONLY","REVERSIBLE_MUTATION","IRREVERSIBLE_MUTATION","PRIVILEGED","HUMAN_DECISION","AGENT_EXECUTABLE"]},"phase":{"type":"integer","minimum":1},"wave":{"type":"integer","minimum":1},"parallel":{"type":"boolean"},"acceptance":{"type":"string","minLength":1},"evidence":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},"failure":{"type":"string","minLength":1},"branch":{"type":"string","pattern":"^IF\\b[\\s\\S]*\\bTHEN\\b"},"workaround":{"type":"string","minLength":1},"fallback":{"type":"string","minLength":1},"rollback":{"type":"string","minLength":1},"escalation":{"type":"string","minLength":1},"downstreamUnlocks":{"$ref":"#/$defs/stringList"},"canonicalDestination":{"type":"string","minLength":1}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
