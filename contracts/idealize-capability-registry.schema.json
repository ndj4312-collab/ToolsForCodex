    "capabilities": {"type":"array","minItems":8,"items":{"type":"object","required":["id","primitive","source","license","implementation","adaptation","harness","stages","inputs","outputs","context","runtime","permissions","dependencies","routing","verification","limitations","fallback","version","owner"],"properties":{"id":{"type":"string","pattern":"^idealize\\."},"primitive":{"type":"string","minLength":1},"source":{"type":"string","minLength":1},"license":{"type":"string","minLength":1},"implementation":{"type":"string","minLength":1},"adaptation":{"enum":["USE","WRAP","SPECIALIZE","COMPOSE","MODIFY","EXTRACT_PATTERN","REJECT","BUILD"]},"harness":{"type":"string","minLength":1},"stages":{"type":"array","minItems":1,"items":{"type":"string"}},"inputs":{"type":"array","items":{"type":"string"}},"outputs":{"type":"array","items":{"type":"string"}},"context":{"type":"array","items":{"type":"string"}},"runtime":{"type":"array","minItems":1,"items":{"type":"string"}},"permissions":{"type":"array","items":{"type":"string"}},"dependencies":{"type":"array","items":{"type":"string"}},"routing":{"type":"string","minLength":1},"verification":{"type":"string","minLength":1},"limitations":{"type":"array","items":{"type":"string"}},"fallback":{"type":"string","minLength":1},"version":{"type":"string","minLength":1},"owner":{"type":"string","minLength":1}},"additionalProperties":false}}
  },
  "additionalProperties": false
}
