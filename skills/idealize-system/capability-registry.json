{
  "$schema": "../../contracts/idealize-capability-registry.schema.json",
  "version": "1.0.0",
  "canonical_owner": "skills/idealize-system",
  "precedence": [
    "verified-runtime",
    "canonical-repository",
    "canonical-notion-ledger",
    "verified-primary-source",
    "derived-research",
    "derived-planning"
  ],
  "capabilities": [
    {
      "id": "idealize.about",
      "primitive": "minimum-sufficient context acquisition",
