      "inputs": ["validated context", "investigation graph"],
      "outputs": ["perfected-system artifact family"],
      "fallback": "return unresolved nodes to investigate",
      "verification": "load_skill + contract fixture"
    },
    {
      "id": "idealize.plan",
      "primitive": "backward chaining and dependency-safe plan compilation",
      "implementation": "skills/idealize-system/idealize/SKILL.md",
      "adaptation": "SPECIALIZE_COMPOSE",
      "stages": ["idealize"],
      "inputs": ["perfected-system model"],
      "outputs": ["the-ideal-project-plan.md"],
      "fallback": "block affected branch only; research workaround",
