    },
    {
      "id": "idealize.investigate",
      "primitive": "recursive gap and capability research",
      "implementation": "skills/idealize-system/investigate/SKILL.md",
      "adaptation": "SPECIALIZE_COMPOSE",
      "stages": ["investigate"],
      "inputs": ["context.md"],
      "outputs": ["research/data graph", "adaptation decisions"],
      "fallback": "capability/workaround ladder",
      "verification": "load_skill + contract fixture"
    },
    {
      "id": "idealize.monolithize",
      "primitive": "coherent perfected-system synthesis",
      "implementation": "skills/idealize-system/monolithize/SKILL.md",
      "adaptation": "SPECIALIZE",
